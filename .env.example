# Token del bot (Discord Developer Portal -> Bot -> Token)
DISCORD_TOKEN=

# Client ID dell'applicazione (Developer Portal -> General Information -> Application ID)
CLIENT_ID=

# (Opzionale) ID di un server per registrare i comandi SOLO li' (aggiornamento istantaneo, utile in sviluppo)
# Lascialo vuoto per registrare i comandi globalmente (ci mette fino a 1h a propagarsi su tutti i server)
GUILD_ID=

# Timezone usata per calcolare "mezzanotte" quando si controllano i compleanni (es. Europe/Rome)
TZ=Europe/Rome

# Database Turso (dashboard web: https://turso.tech -> crea un database -> copia URL e token)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
